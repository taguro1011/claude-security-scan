#!/usr/bin/env bash
# どこから呼んでも同じフォルダの scan.py を実行する
DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
# Windows の Git Bash では python3 がストアを開くだけのダミーのことがあるので py ランチャーを先に使う
cands=(python3 "py -3" python)
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) cands=("py -3" python python3) ;; esac
for py in "${cands[@]}"; do
  if command -v ${py%% *} >/dev/null 2>&1; then exec $py "$DIR/scan.py" "$@"; fi
done
echo "Python 3.11 以上が見つかりません" >&2; exit 1
